<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.jobmonitor.priority</string>
<key>ProgramArguments</key><array><string>__RUNTIME__/mac/run_priority_monitor.sh</string></array>
<key>StartInterval</key><integer>600</integer><key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>__HOME__/Library/Logs/job-monitor-priority.log</string>
<key>StandardErrorPath</key><string>__HOME__/Library/Logs/job-monitor-priority-error.log</string>
</dict></plist>
